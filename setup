#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "=== ai-coding-setup bootstrap ==="
echo ""

# ── Find node >= 22 ──────────────────────────────────────────────────

check_node() {
  local bin="$1"
  if [ -x "$bin" ]; then
    local ver
    ver=$("$bin" --version 2>/dev/null | sed 's/^v//' || echo "0")
    local major="${ver%%.*}"
    if [[ "$major" -ge 22 ]]; then
      echo "$bin"
      return 0
    fi
  fi
  return 1
}

find_node() {
  # PATH first
  if command -v node &>/dev/null; then
    check_node "$(command -v node)" && return 0
  fi

  # Common locations (macOS + Linux)
  local candidates=(
    /opt/homebrew/bin/node
    /usr/local/bin/node
    /usr/bin/node
    "$HOME/.local/share/mise/installs/node/latest/bin/node"
    "$HOME/.asdf/shims/node"
    /snap/bin/node
  )

  # nvm — find latest installed version
  if [ -d "$HOME/.nvm/versions/node" ]; then
    local nvm_latest
    nvm_latest=$(ls -1d "$HOME/.nvm/versions/node"/v* 2>/dev/null | sort -V | tail -1)
    [ -n "$nvm_latest" ] && candidates+=("$nvm_latest/bin/node")
  fi

  for c in "${candidates[@]}"; do
    check_node "$c" && return 0
  done

  return 1
}

NODE=$(find_node) || { echo "ERROR: node >= 22 not found"; exit 1; }
echo "  node: $NODE ($($NODE --version))"

# Record the chosen node so qmd always runs under the same one. qmd's shebang is
# `#!/usr/bin/env node`, and its better-sqlite3 binding is ABI-locked to a single
# Node major — so the file-watcher (which runs under a minimal systemd/launchd
# PATH) must not pick a different node than the one we build the binding against.
NODE_PIN_DIR="$HOME/.local/state/ai-coding-setup"
mkdir -p "$NODE_PIN_DIR"
dirname "$NODE" > "$NODE_PIN_DIR/node-bin-dir"

# ── Find package manager ─────────────────────────────────────────────

PKG_MGR=""
if command -v bun &>/dev/null; then
  PKG_MGR="bun"
elif command -v npm &>/dev/null; then
  PKG_MGR="npm"
else
  echo "ERROR: npm or bun required"
  exit 1
fi
echo "  pkg:  $PKG_MGR"

# ── Install qmd if needed ────────────────────────────────────────────

if command -v qmd &>/dev/null; then
  echo "  qmd:  $(command -v qmd)"
else
  echo "  Installing qmd..."
  $PKG_MGR install -g @tobilu/qmd
fi

# ── Ensure better-sqlite3's native binding is built ──────────────────
# bun skips postinstall scripts on global installs, so qmd's better-sqlite3
# binding can be missing entirely. Its location varies by installer: bun
# hoists it to the global root, npm may nest it under @tobilu/qmd.
NPM_ROOT="$(npm root -g 2>/dev/null || true)"
BSQLITE_ROOT=""
for candidate in \
  "$HOME/.bun/install/global" \
  "$NPM_ROOT/@tobilu/qmd" \
  "${NPM_ROOT%/node_modules}"
do
  if [ -n "$candidate" ] && [ -d "$candidate/node_modules/better-sqlite3" ]; then
    BSQLITE_ROOT="$candidate"
    break
  fi
done

# better-sqlite3 resolves its native binding lazily in the Database constructor,
# so requiring the module is not enough to prove the binding exists.
binding_loads() {
  (cd "$BSQLITE_ROOT" && "$NODE" -e "new (require('better-sqlite3'))(':memory:').close()") >/dev/null 2>&1
}

if [ -z "$BSQLITE_ROOT" ]; then
  echo "  WARN: better-sqlite3 not found; qmd indexing may not work"
elif binding_loads; then
  echo "  sqlite: better-sqlite3 binding OK"
else
  echo "  Building better-sqlite3 native binding..."
  (cd "$BSQLITE_ROOT" && npm rebuild better-sqlite3 2>&1 | grep -v "^npm warn") || true
  if binding_loads; then
    echo "  sqlite: better-sqlite3 binding built"
  else
    echo "  WARN: better-sqlite3 build failed; qmd indexing will not work"
    echo "        try: (cd $BSQLITE_ROOT && npm rebuild better-sqlite3)"
  fi
fi

# ── Install rtk if needed (pinned) ──────────────────────────────────

RTK_VERSION="v0.42.4"
if command -v rtk &>/dev/null; then
  echo "  rtk:  $(command -v rtk)"
else
  echo "  Installing rtk ${RTK_VERSION}..."
  if curl -fsSL "https://raw.githubusercontent.com/rtk-ai/rtk/${RTK_VERSION}/install.sh" \
       | RTK_VERSION="$RTK_VERSION" sh; then
    echo "  rtk:  installed (${RTK_VERSION})"
  else
    echo "  WARN: rtk install failed; skipping (hook stays inactive until rtk is on PATH)"
  fi
fi
echo ""

# ── Install deps + compile ────────────────────────────────────────────

echo "--- Installing dependencies ---"
cd "$REPO_DIR"
$PKG_MGR install
echo ""

echo "--- Compiling TypeScript ---"
npx tsc
echo ""

echo "--- Installing CLI commands ---"
npm link
echo ""

# ── Run setup ─────────────────────────────────────────────────────────

exec "$NODE" "$REPO_DIR/dist/setup.js"
