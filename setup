#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "=== ai-coding-setup bootstrap ==="
echo ""

# ── Find node >= 22 ──────────────────────────────────────────────────

check_node() {
  local bin="$1"
  if [ -x "$bin" ]; then
    local ver
    ver=$("$bin" --version 2>/dev/null | sed 's/^v//' || echo "0")
    local major="${ver%%.*}"
    if [[ "$major" -ge 22 ]]; then
      echo "$bin"
      return 0
    fi
  fi
  return 1
}

find_node() {
  # PATH first
  if command -v node &>/dev/null; then
    check_node "$(command -v node)" && return 0
  fi

  # Common locations (macOS + Linux)
  local candidates=(
    /opt/homebrew/bin/node
    /usr/local/bin/node
    /usr/bin/node
    "$HOME/.local/share/mise/installs/node/latest/bin/node"
    "$HOME/.asdf/shims/node"
    /snap/bin/node
  )

  # nvm — find latest installed version
  if [ -d "$HOME/.nvm/versions/node" ]; then
    local nvm_latest
    nvm_latest=$(ls -1d "$HOME/.nvm/versions/node"/v* 2>/dev/null | sort -V | tail -1)
    [ -n "$nvm_latest" ] && candidates+=("$nvm_latest/bin/node")
  fi

  for c in "${candidates[@]}"; do
    check_node "$c" && return 0
  done

  return 1
}

NODE=$(find_node) || { echo "ERROR: node >= 22 not found"; exit 1; }
echo "  node: $NODE ($($NODE --version))"

# ── Find package manager ─────────────────────────────────────────────

PKG_MGR=""
if command -v bun &>/dev/null; then
  PKG_MGR="bun"
elif command -v npm &>/dev/null; then
  PKG_MGR="npm"
else
  echo "ERROR: npm or bun required"
  exit 1
fi
echo "  pkg:  $PKG_MGR"

# ── Install qmd if needed ────────────────────────────────────────────

if command -v qmd &>/dev/null; then
  echo "  qmd:  $(command -v qmd)"
else
  echo "  Installing qmd..."
  $PKG_MGR install -g @tobilu/qmd
fi

# Rebuild better-sqlite3 for the current Node version (handles Node upgrades)
QMD_PKG_DIR=""
if [ "$PKG_MGR" = "bun" ]; then
  QMD_PKG_DIR="$HOME/.bun/install/global/node_modules/@tobilu/qmd"
else
  QMD_PKG_DIR="$(npm root -g 2>/dev/null)/@tobilu/qmd"
fi
if [ -d "$QMD_PKG_DIR/node_modules/better-sqlite3" ]; then
  echo "  Rebuilding better-sqlite3 for Node $($NODE --version)..."
  (cd "$QMD_PKG_DIR" && npm rebuild better-sqlite3 2>&1 | grep -v "^npm warn") || echo "  WARN: better-sqlite3 rebuild failed; qmd may not work"
fi

# ── Install rtk if needed (pinned) ──────────────────────────────────

RTK_VERSION="v0.42.4"
if command -v rtk &>/dev/null; then
  echo "  rtk:  $(command -v rtk)"
else
  echo "  Installing rtk ${RTK_VERSION}..."
  if curl -fsSL "https://raw.githubusercontent.com/rtk-ai/rtk/${RTK_VERSION}/install.sh" \
       | RTK_VERSION="$RTK_VERSION" sh; then
    echo "  rtk:  installed (${RTK_VERSION})"
  else
    echo "  WARN: rtk install failed; skipping (hook stays inactive until rtk is on PATH)"
  fi
fi
echo ""

# ── Install deps + compile ────────────────────────────────────────────

echo "--- Installing dependencies ---"
cd "$REPO_DIR"
$PKG_MGR install
echo ""

echo "--- Compiling TypeScript ---"
npx tsc
echo ""

echo "--- Installing CLI commands ---"
npm link
echo ""

# ── Run setup ─────────────────────────────────────────────────────────

exec "$NODE" "$REPO_DIR/dist/setup.js"
