#!/usr/bin/env bash
# qmd auto-embed watcher — container/no-init equivalent of the systemd .path unit.
# Runs qmd-auto-embed.sh on every git ref change in a watched repo's .git/logs/HEAD.
set -u

EMBED="$HOME/.local/bin/qmd-auto-embed.sh"
DEBOUNCE=5  # seconds; collapse bursts (e.g. a rebase rewrites HEAD many times)

WATCH_PATHS=(
{{#watchPaths}}
  "{{{.}}}"
{{/watchPaths}}
)

while true; do
  # No -m: exit after one event so the loop re-arms — this also recovers when git
  # atomically replaces a reflog and drops the old watch.
  if inotifywait -q -e modify -e move_self -e delete_self \
       "${WATCH_PATHS[@]}" >/dev/null 2>&1; then
    sleep "$DEBOUNCE"
    "$EMBED"
  else
    sleep 2  # a watched path is momentarily missing; wait for it back
  fi
done
