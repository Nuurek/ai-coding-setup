{
  "name": "ai-coding-setup",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/nuurek/ai-coding-setup/tooling:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  },
  "initializeCommand": "mkdir -p /shared/ai-coding-setup/claude /shared/qmd-models /shared/gh",
  "mounts": [
    "source=/shared/ai-coding-setup/claude,target=/home/vscode/.claude,type=bind",
    "source=/shared/qmd-models,target=/home/vscode/.cache/qmd/models,type=bind",
    "source=/shared/gh,target=/home/vscode/.config/gh,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "postCreateCommand": "npm ci && git config core.hooksPath .githooks",
  "waitFor": "postCreateCommand"
}
